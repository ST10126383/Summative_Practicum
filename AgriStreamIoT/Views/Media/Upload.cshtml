@{
    ViewData["Title"] = "Upload Drone Image";
}

<div class="container mt-4">
    <h2>Upload Drone / Field Imagery</h2>
    <p class="text-muted">Images are stored in Azure Blob Storage. A <strong>Blob-triggered Azure Function</strong> will automatically write an audit entry to Azure Table Storage.</p>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Select image file (JPEG, PNG, TIFF)</label>
                    <input type="file" name="file" class="form-control" accept="image/*,.tif,.tiff" required />
                </div>
                <button type="submit" class="btn btn-primary">Upload to Blob Storage</button>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>
